{
  "name": "react",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "pnpm --filter @examples/shared dev",
    "dev:client": "vite",
    "build": "vite build && tsc -b",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@examples/shared": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/router-plugin": "1.168.48",
    "mock-dash": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "1.0.0",
    "globals": "^17.14.0",
    "typescript-plugin-css-modules": "^5.3.0"
  }
}
